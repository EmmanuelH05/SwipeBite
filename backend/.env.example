# ── Required ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require
JWT_SECRET=replace-with-output-of-openssl-rand-hex-32
GOOGLE_API_KEY=your-google-places-api-key

# ── Optional ──────────────────────────────────────────────────────────────────
# Origin the backend accepts CORS requests from (default: http://localhost:3000)
FRONTEND_URL=http://localhost:3000

# Port the API server listens on (default: 4000)
PORT=4000

# Set to "production" in deployed environments — triggers weak-secret check
NODE_ENV=development
