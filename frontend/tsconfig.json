{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    // Restricts ambient global type declarations to just Node's (needed for
    // constants.ts's `process.env` read). Without this, TS auto-loads every
    // package under node_modules/@types/* as global ambient types -- adding
    // @types/bun (for bun:test, see tsconfig.test.json) would otherwise leak
    // Bun/Node-only globals (Bun.env, Bun.file, Node's Timeout shadowing
    // DOM's number-returning setTimeout) into every browser-bound app file.
    "types": ["node"],
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": ["node_modules", "**/*.test.ts"]
}
